# ============================================================================
#  PAET environment template
#  Copy to backend/.env and fill in. The app reads only backend/.env.
#      cp .env.example backend/.env
#  Never commit backend/.env.
# ============================================================================


# --- Database -------------------------------------------------- REQUIRED ---
# docker compose sets this for its own Postgres, so you can leave it as is
# when running with Docker. Needed when running the backend outside Docker.
DATABASE_URL=postgresql://paet:paet@localhost:5432/paet_db


# --- Login tokens ---------------------------------------------- REQUIRED ---
# Long random string:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string


# --- Server model ---------------------------------------------- REQUIRED ---
# The model PAET uses for students who have not picked their own.
# Option A, NVIDIA NIM:
NVIDIA_API_KEY=
# Option B, any other provider (openai, anthropic, gemini, groq, openrouter,
# ollama, lmstudio, custom). When set, this replaces Option A.
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=


# --- Model selector -------------------------------------------- OPTIONAL ---
# local: students' keys are remembered for a year, and Ollama, LM Studio and
#        custom servers can be picked. Use this on your own machine.
# web:   keys are remembered for 30 days, cloud providers only. Use this on a
#        public server.
DEPLOY_MODE=local
# Seals the key cookie. Falls back to SECRET_KEY. Changing it signs every
# saved key out (students paste them again).
LLM_COOKIE_SECRET=


# --- Email for login codes ------------------------------------- OPTIONAL ---
# Leave all blank on your own machine: login codes are then printed to the
# backend log (docker compose logs backend | grep "\[DEV\] OTP").
# Gmail API (preferred where SMTP ports are blocked):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
# Or SMTP. For Gmail, SMTP_PASSWORD must be an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=PAET


# --- App ------------------------------------------------------- OPTIONAL ---
DEBUG=True
# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# off | silent | live: points and badges hidden, shown on request, or toasted.
GAMIFICATION_MODE=live
