# ============================================================================
#  PAET settings. All optional for `docker compose up`.
#  To change any of them: cp .env.example backend/.env, then edit backend/.env.
#  Never commit backend/.env.
# ============================================================================


# --- Server model ----------------------------------------------------------
# Leave empty and each student picks a model in the Model window.
# Set one to give every student a ready model, and to grade in the background.
# Option A, NVIDIA NIM:
NVIDIA_API_KEY=
# Option B, any other provider (openai, anthropic, gemini, groq, openrouter,
# ollama, lmstudio, custom).
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=


# --- Running outside Docker or on a server ---------------------------------
# docker compose sets these itself.
DATABASE_URL=postgresql://paet:paet@localhost:5432/paet_db
# Left empty, a key is generated on first start and kept in backend/data/.
SECRET_KEY=
# local: no login screen, one student, local models allowed.
# web:   accounts with email login codes, cloud models only.
DEPLOY_MODE=local
# Seals students' model keys in their browser. Falls back to SECRET_KEY.
LLM_COOKIE_SECRET=


# --- Email for login codes (web mode) --------------------------------------
# Without these, codes are printed to the backend log.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
# Or SMTP. For Gmail, SMTP_PASSWORD must be an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=PAET


# --- App -------------------------------------------------------------------
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# off | silent | live: points and badges hidden, shown on request, or toasted.
GAMIFICATION_MODE=live
