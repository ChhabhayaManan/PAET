    {
      "id": "aita-first-repeat",
      "difficulty": "easy",
      "statement": "The first line contains an integer n. The second line contains n space-separated integers. Read them from left to right and print the first integer that you meet for the second time. If no integer appears twice, print -1.",
      "constraints": "1 <= n <= 1000; each integer is between 1 and 1000.",
      "reference": {
        "language": "python",
        "code": [
          "import sys",
          "",
          "data = sys.stdin.read().split()",
          "t = int(data[0])",
          "pos = 1",
          "for _ in range(t):",
          "    n = int(data[pos])",
          "    values = [int(x) for x in data[pos + 1:pos + 1 + n]]",
          "    pos += 1 + n",
          "    seen = set()",
          "    answer = -1",
          "    for x in values:",
          "        if x in seen:",
          "            answer = x",
          "            break",
          "        seen.add(x)",
          "    print(answer)",
          ""
        ]
      },
      "tests": [
        {
          "input": [
            "5",
            "3 1 4 1 3"
          ],
          "output": [
            "1"
          ]
        },
        {
          "input": [
            "1",
            "7"
          ],
          "output": [
            "-1"
          ]
        },
        {
          "input": [
            "4",
            "2 2 2 2"
          ],
          "output": [
            "2"
          ]
        },
        {
          "input": [
            "6",
            "1 2 3 4 5 6"
          ],
          "output": [
            "-1"
          ]
        },
        {
          "input": [
            "6",
            "1000 5 9 5 1000 9"
          ],
          "output": [
            "5"
          ]
        },
        {
          "input": [
            "4",
            "8 3 8 3"
          ],
          "output": [
            "8"
          ]
        },
        {
          "input": [
            "3",
            "1 1000 1000"
          ],
          "output": [
            "1000"
          ]
        }
      ]
    },
